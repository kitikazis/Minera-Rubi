<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sirve directamente archivos y carpetas que existen (css, js, imágenes)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Cualquier otra ruta entra por el front controller
    RewriteRule ^ index.php [L]
</IfModule>

# ===== Caché de estáticos =====
# Los assets (css/js/svg/img/fuentes) llevan ?v=<mtime> desde asset(), así que
# se pueden cachear 1 año: cuando el archivo cambia, su URL cambia y el navegador
# baja la versión nueva automáticamente. El HTML nunca se cachea.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|gif|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
