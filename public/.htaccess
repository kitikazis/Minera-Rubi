<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sirve directamente archivos y carpetas que existen (css, js, imágenes)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Cualquier otra ruta entra por el front controller
    RewriteRule ^ index.php [L]
</IfModule>
